{
  "schemaVersion": 1,
  "id": "reloadanim",
  "version": "${version}",
  "name": "ReloadAnim",
  "description": "Replaces the red resource reload screen with an animation taken from your resource packs.",
  "authors": ["DVMN2"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["net.dvmn2.reloadanim.client.ReloadAnimClient"]
  },
  "mixins": [
    {
      "config": "reloadanim.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
